<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The game's background everywhere, so nothing ever flashes white. -->
    <color name="game_background">#05070A</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/game_background</item>
        <item name="colorPrimaryDark">@color/game_background</item>
        <item name="colorAccent">#2BE8FF</item>
        <item name="android:windowBackground">@color/game_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/game_background</item>
    </style>

    <!-- Launch: the orb on the dark background (Android 12+), or the full
         launch image on older phones; then the game. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/game_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
